\newlabel{mccgraph1}{{4.11a}{36}{This graph is used to compare model performance using an 80\%-20\% split.\relax }{figure.caption.27}{}}
\newlabel{sub@mccgraph1}{{a}{36}{This graph is used to compare model performance using an 80\%-20\% split.\relax }{figure.caption.27}{}}
\newlabel{mccgraph2}{{4.11b}{36}{This graph compares performance when using the full non-redundant dataset for training.\relax }{figure.caption.27}{}}
