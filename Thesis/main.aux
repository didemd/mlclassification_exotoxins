\newlabel{fig:sequence_length_by_type}{{4.2a}{24}{\textbf {Sequence length distribution for different bacterial exotoxin types.}(measured in amino acids). The x-axis represents the exotoxin types and each toxin type is represented by a distinct colors: Type I (blue), Type II (orange), Type III (pink), Type IV (green), and Unknown (yellow). The y-axis shows sequence length in amino acids, ranging from 0 to approximately 3000 except three outliers.\relax }{figure.caption.14}{}}
\newlabel{sub@fig:sequence_length_by_type}{{a}{24}{\textbf {Sequence length distribution for different bacterial exotoxin types.}(measured in amino acids). The x-axis represents the exotoxin types and each toxin type is represented by a distinct colors: Type I (blue), Type II (orange), Type III (pink), Type IV (green), and Unknown (yellow). The y-axis shows sequence length in amino acids, ranging from 0 to approximately 3000 except three outliers.\relax }{figure.caption.14}{}}
\newlabel{fig:sequence_length_by_target}{{4.2b}{24}{\textbf {Sequence length distribution for different bacterial exotoxin targets.}(measured in amino acids). The x-axis represents the exotoxin targets, and each toxin type is represented by a distinct color: Vertebrates (dark green) and Non-vertebrates (purple). The y-axis shows sequence length in amino acids, ranging from 0 to approximately 2500 except five outliers.\relax }{figure.caption.14}{}}
\newlabel{sub@fig:sequence_length_by_target}{{b}{24}{\textbf {Sequence length distribution for different bacterial exotoxin targets.}(measured in amino acids). The x-axis represents the exotoxin targets, and each toxin type is represented by a distinct color: Vertebrates (dark green) and Non-vertebrates (purple). The y-axis shows sequence length in amino acids, ranging from 0 to approximately 2500 except five outliers.\relax }{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Descriptive Analysis of Bacterial Exotoxin Feature: Sequence Length\relax }}{24}{figure.caption.14}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Deviance residuals vs. fitted values for the GLM on sequence length. This plot is used to assess model fit and shows that large residuals indicate unexplained variance in sequence length across exotoxin types.\relax }}{25}{figure.caption.15}}
\newlabel{fig:res_seq_length}{{4.3}{25}{Deviance residuals vs. fitted values for the GLM on sequence length. This plot is used to assess model fit and shows that large residuals indicate unexplained variance in sequence length across exotoxin types.\relax }{figure.caption.15}{}}
\@writefile{toc}{\contentsline {subsubsection}{Hydrophobicity Feature Analysis}{25}{section*.16}}
\newlabel{fig:hydrophobicity_toxin_type}{{4.4a}{26}{\textbf {Hydrophobicity distribution for different bacterial exotoxin types.}(values calculated per residue). The x-axis represents the exotoxin types and each toxin type is represented by a distinct color: Type I (blue), Type II (orange), Type III (pink), Type IV (green), and Unknown (yellow). The y-axis shows the average hydrophobicity values, ranging from approximately -1.5 to 1.0. Each box plot displays the median hydrophobicity, interquartile range (IQR), and whiskers extending up to 1.5 times the IQR. Individual outliers are marked as points outside the whiskers. The hydrophobicity values vary slightly across toxin types, with Type II showing a wider spread compared to others, while Type I and Type IV are more compact.\relax }{figure.caption.17}{}}
\newlabel{sub@fig:hydrophobicity_toxin_type}{{a}{26}{\textbf {Hydrophobicity distribution for different bacterial exotoxin types.}(values calculated per residue). The x-axis represents the exotoxin types and each toxin type is represented by a distinct color: Type I (blue), Type II (orange), Type III (pink), Type IV (green), and Unknown (yellow). The y-axis shows the average hydrophobicity values, ranging from approximately -1.5 to 1.0. Each box plot displays the median hydrophobicity, interquartile range (IQR), and whiskers extending up to 1.5 times the IQR. Individual outliers are marked as points outside the whiskers. The hydrophobicity values vary slightly across toxin types, with Type II showing a wider spread compared to others, while Type I and Type IV are more compact.\relax }{figure.caption.17}{}}
\newlabel{fig:hydrophobicity_by_target}{{4.4b}{26}{\textbf {Hydrophobicity distribution for different bacterial exotoxin targets.}(values calculated per residue). The x-axis represents the exotoxin targets, and each toxin target is represented by a distinct color: Vertebrates (dark green) and Non-vertebrates (purple). The y-axis shows the average hydrophobicity values, ranging from approximately -1.5 to 1.0. Each box plot summarizes the data, showing the median hydrophobicity, interquartile range (IQR), and whiskers extending up to 1.5 times the IQR, with outliers plotted as individual points. Both vertebrate and non-vertebrate targets have similar distributions, but vertebrate targets exhibit a slightly wider variation in hydrophobicity compared to non-vertebrate targets.\relax }{figure.caption.17}{}}
\newlabel{sub@fig:hydrophobicity_by_target}{{b}{26}{\textbf {Hydrophobicity distribution for different bacterial exotoxin targets.}(values calculated per residue). The x-axis represents the exotoxin targets, and each toxin target is represented by a distinct color: Vertebrates (dark green) and Non-vertebrates (purple). The y-axis shows the average hydrophobicity values, ranging from approximately -1.5 to 1.0. Each box plot summarizes the data, showing the median hydrophobicity, interquartile range (IQR), and whiskers extending up to 1.5 times the IQR, with outliers plotted as individual points. Both vertebrate and non-vertebrate targets have similar distributions, but vertebrate targets exhibit a slightly wider variation in hydrophobicity compared to non-vertebrate targets.\relax }{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Descriptive Analysis of Bacterial Exotoxin Feature: Hydrophobicity\relax }}{26}{figure.caption.17}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces Deviance residuals vs. fitted values for the GLM on hydrophobicity. The scattered residuals suggest that toxin type alone does not strongly predict hydrophobicity, indicating the need for additional explanatory variables.\relax }}{27}{figure.caption.18}}
\newlabel{fig:res_seq_hydro}{{4.5}{27}{Deviance residuals vs. fitted values for the GLM on hydrophobicity. The scattered residuals suggest that toxin type alone does not strongly predict hydrophobicity, indicating the need for additional explanatory variables.\relax }{figure.caption.18}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.0.4}Quality of Protein Folds Based On pLDDT Scores}{27}{subsection.4.0.4}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces LDDT Score Distribution Across Targets. The black line represents the mean LDDT score for each target, while the gray error bars indicate the standard deviation. Red points denote the median LDDT score for each target. This visualization highlights the distribution of model confidence across different protein structures. Low-confidence predictions correspond to LDDT< 50, high confidence regions correspond to LDDT > 70.\relax }}{28}{figure.caption.19}}
\newlabel{fig:lddt_scores}{{4.6}{28}{LDDT Score Distribution Across Targets. The black line represents the mean LDDT score for each target, while the gray error bars indicate the standard deviation. Red points denote the median LDDT score for each target. This visualization highlights the distribution of model confidence across different protein structures. Low-confidence predictions correspond to LDDT< 50, high confidence regions correspond to LDDT > 70.\relax }{figure.caption.19}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.0.5}Dimensionality Reduction Techniques}{29}{subsection.4.0.5}}
\newlabel{fig:pca_toxin_type}{{4.7a}{30}{\textbf {Principal Component Analysis (PCA) projection of bacterial exotoxin types} The x-axis represents Principal Component 1, and the y-axis represents Principal Component 2, both ranging from approximately -1.0 to 1.0. Each exotoxin type is color-coded: Type I (blue), Type II (purple), Type III (pink), Type IV (green), and Unknown (yellow). Clusters suggest some overlap but distinct separations for specific types.\relax }{figure.caption.20}{}}
\newlabel{sub@fig:pca_toxin_type}{{a}{30}{\textbf {Principal Component Analysis (PCA) projection of bacterial exotoxin types} The x-axis represents Principal Component 1, and the y-axis represents Principal Component 2, both ranging from approximately -1.0 to 1.0. Each exotoxin type is color-coded: Type I (blue), Type II (purple), Type III (pink), Type IV (green), and Unknown (yellow). Clusters suggest some overlap but distinct separations for specific types.\relax }{figure.caption.20}{}}
\newlabel{fig:scrambled_pca_toxin_type}{{4.7b}{30}{Scrambled PCA projection of bacterial exotoxin types.The x-axis represents Principal Component 1, and the y-axis represents Principal Component 2, with a wider range of values between -1.5 and 1.0. The same color coding applies:Type I (blue), Type II (purple), Type III (pink), Type IV (green), and Unknown (yellow). The scrambling reduces separation among the clusters, validating the effect of shuffling of protein sequences.\relax }{figure.caption.20}{}}
\newlabel{sub@fig:scrambled_pca_toxin_type}{{b}{30}{Scrambled PCA projection of bacterial exotoxin types.The x-axis represents Principal Component 1, and the y-axis represents Principal Component 2, with a wider range of values between -1.5 and 1.0. The same color coding applies:Type I (blue), Type II (purple), Type III (pink), Type IV (green), and Unknown (yellow). The scrambling reduces separation among the clusters, validating the effect of shuffling of protein sequences.\relax }{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.7}{\ignorespaces Principal Component Analysis Based On Exotoxin Types For Dimensionality Reduction\relax }}{30}{figure.caption.20}}
\newlabel{fig:dimensionality_reduction_toxin_type}{{4.7}{30}{Principal Component Analysis Based On Exotoxin Types For Dimensionality Reduction\relax }{figure.caption.20}{}}
\newlabel{fig:pca_projection_non_scrambled_target}{{4.8a}{32}{Principal Component Analysis (PCA) projection of bacterial exotoxin targets.The x-axis represents Principal Component 1, and the y-axis represents Principal Component 2, both ranging from approximately -1.0 to 1.0. Targets are color-coded: Vertebrates (purple) and Non-vertebrates (dark green). Vertebrate clusters are more compact, while non-vertebrate clusters show broader variability.\relax }{figure.caption.21}{}}
\newlabel{sub@fig:pca_projection_non_scrambled_target}{{a}{32}{Principal Component Analysis (PCA) projection of bacterial exotoxin targets.The x-axis represents Principal Component 1, and the y-axis represents Principal Component 2, both ranging from approximately -1.0 to 1.0. Targets are color-coded: Vertebrates (purple) and Non-vertebrates (dark green). Vertebrate clusters are more compact, while non-vertebrate clusters show broader variability.\relax }{figure.caption.21}{}}
\newlabel{fig:pca_projection_scrambled_target}{{4.8b}{32}{Scrambled PCA projection of bacterial exotoxin targets.The x-axis represents Principal Component 1, and the y-axis represents Principal Component 2, with a wider range of values (-1.5 to 1.0). Targets are color-coded as Vertebrates (orange) and Non-vertebrates (blue). The scrambling reduces cluster compactness, demonstrating the loss of structure in the data.\relax }{figure.caption.21}{}}
\newlabel{sub@fig:pca_projection_scrambled_target}{{b}{32}{Scrambled PCA projection of bacterial exotoxin targets.The x-axis represents Principal Component 1, and the y-axis represents Principal Component 2, with a wider range of values (-1.5 to 1.0). Targets are color-coded as Vertebrates (orange) and Non-vertebrates (blue). The scrambling reduces cluster compactness, demonstrating the loss of structure in the data.\relax }{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces Principal Component Analysis Based On Exotoxin Targets For Dimensionality Reduction\relax }}{32}{figure.caption.21}}
\newlabel{fig:dimensionality_reduction_toxin_target}{{4.8}{32}{Principal Component Analysis Based On Exotoxin Targets For Dimensionality Reduction\relax }{figure.caption.21}{}}
